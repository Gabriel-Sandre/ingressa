{
  "ConnectionStrings": {
    "Ingressa": "Host=localhost;Port=5432;Database=ingressa;Username=ingressa",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Emissor": "Ingressa",
    "Audiencia": "Ingressa.Clientes",
    "Chave": "",
    "ExpiracaoMinutos": 15
  },
  "Admin": {
    "Email": "",
    "Senha": ""
  },
  "Banco": {
    "InicializarAoIniciar": true
  },
  "LimiteDeRequisicoes": {
    "GlobalPorMinuto": 600
  },
  "LimitesDistribuidos": {
    "autenticacao": { "Limite": 10, "JanelaEmSegundos": 60 },
    "reservas": { "Limite": 20, "JanelaEmSegundos": 60 },
    "fila": { "Limite": 30, "JanelaEmSegundos": 60 },
    "fila-consulta": { "Limite": 120, "JanelaEmSegundos": 60 }
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*"
}
