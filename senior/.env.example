# Copie para .env e troque os valores. O arquivo .env nunca vai para o Git.
AMBIENTE=Development
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
REDIS_PASSWORD=troque-esta-senha-do-redis
RABBITMQ_PASSWORD=troque-esta-senha-do-rabbitmq
JWT_CHAVE=troque-por-uma-chave-aleatoria-com-pelo-menos-32-bytes

# Opcional: conta de administrador criada na primeira execução
ADMIN_EMAIL=
ADMIN_SENHA=

# Limites (aumente para os testes de carga, que vêm todos do mesmo IP)
LIMITE_AUTENTICACAO=10
LIMITE_RESERVAS=20
COMPRADORES_SIMULTANEOS=50
